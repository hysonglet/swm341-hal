/* Weak aliases for every NVIC interrupt vector of the SWM341.
 *
 * This file is intentionally not taken from the `swm341-pac` crate: the SVD that
 * crate is generated from only describes the vectors 0..=28, so anything above
 * -- including the GPIO port interrupts (GPIOA = 35, GPIOB = 36, ...) -- would
 * have no vector slot to be claimed by a Rust handler.
 *
 * Generated by `scripts/gen_vector_table.py`; names follow the vendor header
 * `CSL/CMSIS/DeviceSupport/SWM341.h`, which the datasheet also uses.
 */
PROVIDE(UART0 = DefaultHandler);
PROVIDE(UART1 = DefaultHandler);
PROVIDE(TIMR0 = DefaultHandler);
PROVIDE(TIMR1 = DefaultHandler);
PROVIDE(DMA = DefaultHandler);
PROVIDE(SPI0 = DefaultHandler);
PROVIDE(PWM0 = DefaultHandler);
PROVIDE(WDT = DefaultHandler);
PROVIDE(UART2 = DefaultHandler);
PROVIDE(PWM1 = DefaultHandler);
PROVIDE(ADC0 = DefaultHandler);
PROVIDE(BTIMR0 = DefaultHandler);
PROVIDE(HALL0 = DefaultHandler);
PROVIDE(PWM2 = DefaultHandler);
PROVIDE(PWMBRK = DefaultHandler);
PROVIDE(I2C0 = DefaultHandler);
PROVIDE(CAN0 = DefaultHandler);
PROVIDE(SPI1 = DefaultHandler);
PROVIDE(RTC = DefaultHandler);
PROVIDE(PWM3 = DefaultHandler);
PROVIDE(TIMR2 = DefaultHandler);
PROVIDE(UART3 = DefaultHandler);
PROVIDE(TIMR3 = DefaultHandler);
PROVIDE(ADC1 = DefaultHandler);
PROVIDE(BOD = DefaultHandler);
PROVIDE(CORDIC = DefaultHandler);
PROVIDE(BTIMR1 = DefaultHandler);
PROVIDE(PWM4 = DefaultHandler);
PROVIDE(HALL3 = DefaultHandler);
PROVIDE(BTIMR2 = DefaultHandler);
